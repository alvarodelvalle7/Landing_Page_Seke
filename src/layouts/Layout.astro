---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

// ====== PROPS DE LAYOUT ======
// title: Título de la página HTML que aparecerá en la pestaña del navegador
interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    {/* Configuración responsive para que el sitio se adapte a cualquier pantalla */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Favicon para la pestaña de la web */}
    <link rel="icon" href="/blackpanthersekewhite.png" sizes="any" />
    {/* Título dinámico de la página */}
    <title>{title}</title>
    {/* ClientRouter activa navegación sin recargar página (transiciones suaves) */}
    <ClientRouter />
</head>

<body class="min-h-screen bg-[#000000] text-white antialiased">

    {/* Contenedor principal que mantiene Navbar fija arriba, contenido al medio, Footer abajo */}
    <div class="flex min-h-screen flex-col">

        {/* Navbar persiste entre cambios de página (transition:persist) */}
        <Navbar transition:persist/>

        {/* Área principal donde se renderiza el contenido de cada página */}
        <main class="flex-1">
            <slot />
        </main>

        {/* Footer persiste entre cambios de página (transition:persist) */}
        <Footer transition:persist/>

    </div>

</body>

</html>

